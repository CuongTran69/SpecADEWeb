---
import type { Lang } from '~/i18n/strings'
import { t } from '~/i18n/strings'
import CopyBlock from '~/components/CopyBlock.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const strings = t(lang)
const content = strings.notepadAiPage
---

<section class="np-hero np-section">
  <div class="container-wide">
    <div class="np-hero-inner reveal">
      <h2 class="np-hero-heading">{content.hero.heading}</h2>
      <p class="np-hero-subtitle">{content.hero.subtitle}</p>
      <div class="np-hero-ctas">
        <a href="https://github.com/nullmastermind/NotepadAI" rel="noopener noreferrer" target="_blank" class="btn btn-primary">
          {content.hero.primaryCta}
          <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4"/>
          </svg>
        </a>
        <a href="#features" class="btn btn-ghost">
          {content.hero.secondaryCta}
        </a>
      </div>
      <div class="np-metrics">
        {content.hero.metrics.map((metric) => (
          <div class="np-metric-card">
            <div class="np-metric-value">{metric.value}</div>
            <div class="np-metric-label">{metric.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="np-features np-section" id="features">
  <div class="container-wide">
    <header class="section-head reveal">
      <h2 class="section-title">{content.features.heading}</h2>
    </header>
    <div class="np-features-grid">
      {content.features.items.map((feature) => (
        <div class="np-feature-card reveal">
          <svg class="np-feature-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 1v14M1 8h14M3.5 3.5l9 9M12.5 3.5l-9 9"/>
          </svg>
          <h3 class="np-feature-title">{feature.title}</h3>
          <p class="np-feature-desc">{feature.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="np-platforms np-section">
  <div class="container-wide">
    <header class="section-head reveal">
      <h2 class="section-title">{content.platforms.heading}</h2>
    </header>

    <div class="np-platforms-table-wrap">
      <table class="np-platforms-table reveal">
        <tbody>
          {content.platforms.items.map((platform) => (
            <tr>
              <td class="np-platform-name">{platform.name}</td>
              <td class="np-platform-ext">{platform.ext}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="np-platforms-note reveal">{content.platforms.note}</p>
  </div>
</section>

<section class="np-install np-section">
  <div class="container-wide">
    <header class="section-head reveal">
      <h2 class="section-title">{content.install.heading}</h2>
    </header>

    <div class="np-install-steps reveal">
      <div class="np-install-step">
        <h3 class="np-install-step-title">{content.install.npxLabel}</h3>
        <CopyBlock code="cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release" />
      </div>

      <div class="np-install-step">
        <h3 class="np-install-step-title">{content.install.globalLabel}</h3>
        <CopyBlock code="cmake --build build --parallel" />
      </div>

      <div class="np-install-step">
        <h3 class="np-install-step-title">{content.install.flagsLabel}</h3>
        <p class="np-install-download-text">
          {content.install.flagsNote}
          <a href="https://github.com/nullmastermind/NotepadAI/releases" rel="noopener noreferrer" target="_blank">{content.install.releasesLink}</a>
        </p>
      </div>
    </div>

    <div class="np-install-info reveal">
      <div class="np-install-info-block">
        <h3 class="np-info-heading">{content.install.portsLabel}</h3>
        <p class="np-info-text">{content.install.portNote}</p>
      </div>

      <div class="np-install-info-block">
        <h3 class="np-info-heading">{content.install.platformsLabel}</h3>
        <p class="np-info-text">{content.install.platforms}</p>
      </div>
    </div>
  </div>
</section>

<section class="np-github np-section np-section--accent">
  <div class="container-wide">
    <div class="np-github-inner reveal">
      <h2 class="np-github-heading">{content.github.heading}</h2>
      <p class="np-github-body">{content.github.body}</p>
      <a href="https://github.com/nullmastermind/NotepadAI" rel="noopener noreferrer" target="_blank" class="btn btn-primary">
        {content.github.button}
        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .np-section {
    padding: clamp(56px, 8vw, 88px) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .np-section:last-child {
    border-bottom: none;
  }

  .np-section--accent {
    background: var(--color-surface);
  }

  .container-wide {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 32px);
  }

  /* Hero */
  .np-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 52rem;
  }

  .np-hero-heading {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-text);
    line-height: 1.15;
    margin: 0;
  }

  .np-hero-subtitle {
    font-size: clamp(1rem, 1.3vw, 1.0625rem);
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .np-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-top: 8px;
  }

  .np-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 16px;
    margin-top: 16px;
  }

  .np-metric-card {
    padding: 16px;
    background: var(--color-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .np-metric-value {
    font-size: 24px;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1.2;
  }

  .np-metric-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 6px;
  }

  /* Section Head */
  .section-head {
    margin-bottom: clamp(32px, 5vw, 48px);
  }

  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0;
    line-height: 1.2;
  }

  /* Features */
  .np-features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .np-feature-card {
    padding: 20px;
    background: var(--color-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: all 200ms var(--ease-out-soft);
  }

  .np-feature-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 12px color-mix(in oklab, var(--color-accent) 15%, transparent);
  }

  .np-feature-icon {
    width: 24px;
    height: 24px;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .np-feature-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .np-feature-desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Platforms */
  .np-platforms-table-wrap {
    overflow-x: auto;
    margin-bottom: 16px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    min-width: 0;
  }

  .np-platforms-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--color-raised);
    min-width: 0;
  }

  .np-platforms-table tr {
    border-bottom: 1px solid var(--color-border);
  }

  .np-platforms-table tr:last-child {
    border-bottom: none;
  }

  .np-platforms-table td {
    padding: 12px 16px;
    font-size: 14px;
  }

  .np-platform-name {
    color: var(--color-text);
    font-weight: 500;
  }

  .np-platform-ext {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 12px;
    word-break: break-word;
    white-space: normal;
  }

  .np-platforms-note {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Install */
  .np-install-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    margin-bottom: 32px;
    min-width: 0;
  }

  .np-install-step {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .np-install-step-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .np-install-step :global(.copy-block) {
    min-width: 0;
  }

  .np-install-step :global(.copy-pre) {
    min-width: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .np-install-download-text {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .np-install-download-text a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
    transition: color 200ms var(--ease-out-soft);
  }

  .np-install-download-text a:hover {
    color: color-mix(in oklab, var(--color-accent) 120%, transparent);
    text-decoration: underline;
  }

  .np-install-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }

  .np-install-info-block {
    padding: 16px;
    background: var(--color-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .np-info-heading {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 8px;
  }

  .np-info-text {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* GitHub CTA */
  .np-github-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    max-width: 48rem;
    margin: 0 auto;
  }

  .np-github-heading {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    line-height: 1.2;
    margin: 0;
  }

  .np-github-body {
    font-size: clamp(1rem, 1.2vw, 1.0625rem);
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Reveal animation */
  .reveal {
    opacity: 0;
    animation: revealIn 600ms ease-out forwards;
  }

  @keyframes revealIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .np-metrics {
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    }
  }

  @media (max-width: 768px) {
    .np-section {
      padding: clamp(40px, 5vw, 56px) 0;
    }

    .np-metrics {
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .np-metric-card {
      padding: 12px;
    }

    .np-metric-value {
      font-size: 20px;
    }

    .np-features-grid {
      grid-template-columns: 1fr;
    }

    .np-install-steps {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 375px) {
    .np-hero-ctas {
      flex-direction: column;
      width: 100%;
    }

    .np-hero-ctas .btn {
      width: 100%;
    }

    .np-metrics {
      grid-template-columns: repeat(3, 1fr);
    }

    .np-metric-value {
      font-size: 18px;
    }
  }
</style>
