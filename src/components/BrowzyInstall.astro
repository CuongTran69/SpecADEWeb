---
import type { Lang } from '~/i18n/strings'
import { t } from '~/i18n/strings'
import { pathFor } from '~/i18n/utils'
import CopyBlock from '~/components/CopyBlock.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const strings = t(lang)
const content = strings.browzyInstallPage
const browzyHref = pathFor(lang, '/browzy')

const shotBase = `${import.meta.env.BASE_URL}browzy/screenshots/`.replace(/\/{2,}/g, '/')
---

<section class="bzi-section" id="two-halves">
  <div class="container-wide">
    <header class="section-head reveal">
      <h2 class="section-title">{content.intro.heading}</h2>
      <p class="section-subtitle">{content.intro.body}</p>
    </header>

    <div class="bzi-halves-table-wrap reveal">
      <table class="bzi-halves-table">
        <thead>
          <tr>
            <th>{content.intro.table.halfLabel}</th>
            <th>{content.intro.table.whatLabel}</th>
            <th>{content.intro.table.whereLabel}</th>
          </tr>
        </thead>
        <tbody>
          {content.intro.table.rows.map((row) => (
            <tr>
              <td class="bzi-half-cell">{row.half}</td>
              <td>{row.what}</td>
              <td class="bzi-where-cell">{row.where}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="bzi-section" id="prerequisites">
  <div class="container-wide">
    <header class="section-head reveal">
      <h2 class="section-title">{content.prerequisites.heading}</h2>
    </header>

    <div class="bzi-prereq-grid reveal">
      {content.prerequisites.items.map((item) => (
        <a href={item.href} rel="noopener noreferrer" target="_blank" class="bzi-prereq-card">
          <span class="bzi-prereq-label">{item.label}</span>
          <span class="bzi-prereq-desc">{item.desc}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="bzi-section" id="steps">
  <div class="container-wide">
    <header class="section-head reveal">
      <h2 class="section-title">{content.steps.heading}</h2>
    </header>

    <ol class="bzi-steps reveal">
      {content.steps.items.map((step) => (
        <li class="bzi-step">
          <h3 class="bzi-step-title">{step.title}</h3>
          <p class="bzi-step-body">{step.body}</p>

          {step.codeBlocks.length > 0 && (
            <div class="bzi-step-codeblocks">
              {step.codeBlocks.map((block) => (
                <div class="bzi-step-codeblock">
                  {block.label && <span class="bzi-code-label">{block.label}</span>}
                  <CopyBlock code={block.code} />
                </div>
              ))}
            </div>
          )}

          <div class="bzi-result">
            <span class="bzi-result-label">{lang === 'vi' ? 'Kết quả mong đợi' : 'What you should see'}</span>
            <p class="bzi-result-text">{step.result}</p>
          </div>

          {step.screenshot.file && (
            <figure class="bzi-shot">
              <img
                src={`${shotBase}${step.screenshot.file}`}
                alt={step.screenshot.alt}
                loading="lazy"
              />
              <figcaption>{step.screenshot.caption}</figcaption>
            </figure>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="bzi-section" id="failures">
  <div class="container-wide">
    <header class="section-head reveal">
      <h2 class="section-title">{content.failures.heading}</h2>
    </header>

    <div class="bzi-failures reveal">
      {content.failures.items.map((item) => (
        <div class="callout warning">
          <div class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
          </div>
          <div class="ct">
            <strong>{item.title}</strong>
            <p>{item.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="bzi-section" id="doctor">
  <div class="container-wide">
    <header class="section-head reveal">
      <h2 class="section-title">{content.doctor.heading}</h2>
      <p class="section-subtitle">{content.doctor.body}</p>
    </header>

    <div class="bzi-doctor reveal">
      <CopyBlock code={content.doctor.code} />
      <p class="bzi-alias-note">{content.doctor.aliasNote}</p>

      <div class="bzi-doctor-output">
        <h3 class="bzi-doctor-output-heading">{content.doctor.output.heading}</h3>
        <ul class="bzi-doctor-output-list">
          {content.doctor.output.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      {content.doctor.screenshot.file && (
        <figure class="bzi-shot">
          <img
            src={`${shotBase}${content.doctor.screenshot.file}`}
            alt={content.doctor.screenshot.alt}
            loading="lazy"
          />
          <figcaption>{content.doctor.screenshot.caption}</figcaption>
        </figure>
      )}
    </div>
  </div>
</section>

<section class="bzi-section" id="faq">
  <div class="container-wide">
    <header class="section-head reveal">
      <h2 class="section-title">{content.faq.heading}</h2>
    </header>

    <div class="bzi-faq-list reveal">
      {content.faq.items.map((item, i) => (
        <details class="bzi-faq-item" data-testid={`browzy-faq-item-${i}`}>
          <summary class="bzi-faq-summary">
            <span class="bzi-faq-q">{item.q}</span>
            <span class="bzi-faq-chevron" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 6l4 4 4-4"/>
              </svg>
            </span>
          </summary>
          <div class="bzi-faq-answer">
            <p>{item.a}</p>
            {item.linkHref && (
              <a href={item.linkHref} rel="noopener noreferrer" target="_blank" class="bzi-faq-link">
                {item.linkLabel}
                <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 8h10M9 4l4 4-4 4"/>
                </svg>
              </a>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="bzi-section bzi-section--accent" id="cta">
  <div class="container-wide">
    <div class="bzi-cta-inner reveal">
      <h2 class="bzi-cta-heading">{content.cta.heading}</h2>
      <p class="bzi-cta-body">{content.cta.body}</p>
      <div class="bzi-cta-buttons">
        <a href={browzyHref} class="btn btn-secondary">{content.cta.productCta}</a>
        <a href="https://github.com/Nguy-n-Th-Huy/Browzy" rel="noopener noreferrer" target="_blank" class="btn btn-primary">{content.cta.githubCta}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .bzi-section {
    padding: clamp(48px, 7vw, 72px) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .bzi-section:last-of-type {
    border-bottom: none;
  }

  .bzi-section--accent {
    background: var(--color-surface);
  }

  .container-wide {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 32px);
  }

  .section-head {
    margin-bottom: clamp(24px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Two-halves table */
  .bzi-halves-table-wrap {
    overflow-x: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .bzi-halves-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--color-raised);
    min-width: 480px;
  }

  .bzi-halves-table th {
    text-align: left;
    padding: 10px 14px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
  }

  .bzi-halves-table td {
    padding: 12px 14px;
    font-size: 13.5px;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .bzi-half-cell {
    color: var(--color-text);
    font-weight: 600;
    white-space: nowrap;
  }

  .bzi-where-cell {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-accent);
  }

  /* Prerequisites */
  .bzi-prereq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .bzi-prereq-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    background: var(--color-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color 200ms var(--ease-out-soft);
  }

  .bzi-prereq-card:hover {
    border-color: var(--color-accent);
  }

  .bzi-prereq-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
  }

  .bzi-prereq-desc {
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  /* Steps */
  .bzi-steps {
    counter-reset: bzi-step;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bzi-step {
    position: relative;
    padding: 0 0 clamp(28px, 4vw, 40px) 40px;
    border-left: 1px solid var(--color-border);
    margin-left: 14px;
  }

  .bzi-step:last-child {
    border-left-color: transparent;
    padding-bottom: 0;
  }

  .bzi-step::before {
    counter-increment: bzi-step;
    content: counter(bzi-step);
    position: absolute;
    left: -15px;
    top: -2px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    display: grid;
    place-items: center;
    font: 600 12.5px / 1 var(--font-mono);
    color: var(--color-accent);
  }

  .bzi-step-title {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 700;
    color: var(--color-text);
  }

  .bzi-step-body {
    margin: 0 0 12px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .bzi-step-codeblocks {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 14px;
  }

  .bzi-step-codeblock {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .bzi-code-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .bzi-result {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    background: color-mix(in srgb, var(--color-success) 7%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--color-success) 30%, var(--color-border));
    border-radius: var(--radius-md);
  }

  .bzi-result-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-success);
  }

  .bzi-result-text {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* Screenshots */
  .bzi-shot {
    margin: 16px 0 0;
    padding: 0;
  }

  .bzi-shot img {
    display: block;
    width: 100%;
    max-width: 480px;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .bzi-shot figcaption {
    margin-top: 8px;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  /* Failure callouts (matches the docs callout vocabulary) */
  .bzi-failures {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .callout {
    display: flex;
    gap: 12px;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    line-height: 1.6;
  }

  .callout .ico {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }

  .callout .ct {
    font-size: 14px;
  }

  .callout .ct strong {
    display: block;
    margin-bottom: 4px;
    color: var(--color-text);
  }

  .callout p {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .callout.warning {
    border-color: color-mix(in srgb, var(--color-warning) 40%, var(--color-border));
    background: color-mix(in srgb, var(--color-warning) 8%, var(--color-surface));
  }

  .callout.warning .ico {
    color: var(--color-warning);
  }

  /* Doctor */
  .bzi-doctor {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .bzi-alias-note {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .bzi-doctor-output {
    padding: 16px;
    background: var(--color-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .bzi-doctor-output-heading {
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
  }

  .bzi-doctor-output-list {
    margin: 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bzi-doctor-output-list li {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* FAQ (native details/summary accordion) */
  .bzi-faq-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .bzi-faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-raised);
    padding: 4px 16px;
  }

  .bzi-faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
  }

  .bzi-faq-summary::-webkit-details-marker {
    display: none;
  }

  .bzi-faq-q {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--color-text);
  }

  .bzi-faq-chevron {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform 200ms var(--ease-out-soft);
  }

  .bzi-faq-item[open] .bzi-faq-chevron {
    transform: rotate(180deg);
  }

  .bzi-faq-answer {
    padding: 0 0 16px;
  }

  .bzi-faq-answer p {
    margin: 0 0 8px;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .bzi-faq-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
  }

  .bzi-faq-link:hover {
    text-decoration: underline;
  }

  /* Final CTA */
  .bzi-cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }

  .bzi-cta-heading {
    margin: 0;
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .bzi-cta-body {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .bzi-cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  .reveal {
    opacity: 0;
    animation: bziRevealIn 600ms ease-out forwards;
  }

  @keyframes bziRevealIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 600px) {
    .bzi-step {
      padding-left: 32px;
    }
  }
</style>
