---
import type { Lang } from '~/i18n/strings'
import '~/styles/kit.css'
import KitBlock from '~/components/kits/KitBlock.astro'
import KitChangelog from '~/components/kits/KitChangelog.astro'
import { getKitSections, kitTx, type KitSection } from '~/data/openspec-friendly-content'
import { slugify } from '~/lib/render-changelog'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const sections = getKitSections(lang)

type SectionGroup = { id: string; title: string; sections: KitSection[] }

const intro: KitSection[] = []
const groups: SectionGroup[] = []
let current: SectionGroup | null = null

for (const section of sections) {
  if (section.type === 'h2') {
    if (current) groups.push(current)
    const title = kitTx(lang, section.text)
    current = { id: slugify(title), title, sections: [] }
    continue
  }
  if (!current) intro.push(section)
  else current.sections.push(section)
}
if (current) groups.push(current)

const tocItems = groups.map((g) => ({ id: g.id, label: g.title }))
const tocLabel = lang === 'vi' ? 'Mục lục' : 'On this page'
---

<div class="kit-layout container-wide">
  <nav class="kit-toc" aria-label={tocLabel}>
    <p class="kit-toc-label">{tocLabel}</p>
    <ul class="kit-toc-list">
      {tocItems.map((item) => (
        <li>
          <a href={`#${item.id}`}>{item.label}</a>
        </li>
      ))}
      <li>
        <a href={`#${lang === 'vi' ? 'nhat-ky-thay-doi' : 'changelog'}`}>
          {lang === 'vi' ? 'Nhật ký thay đổi' : 'Changelog'}
        </a>
      </li>
    </ul>
  </nav>

  <div class="kit-main">
    {intro.length > 0 && (
      <div class="kit-intro">
        <div class="kit-badge-row">
          <span class="kit-badge">OpenSpec Friendly</span>
          <span class="kit-badge">{lang === 'vi' ? 'Spec-driven' : 'Spec-driven'}</span>
        </div>
        {intro.map((section) => {
          if (section.type === 'p') {
            return <p class="kit-lead" set:html={kitTx(lang, section.html)} />
          }
          return <KitBlock lang={lang} section={section} groupTitle="" />
        })}
      </div>
    )}

    {groups.map((group) => {
      const isSetup = group.id === 'setup'
      let setupCopyStep = 0
      return (
        <section id={group.id} class="kit-section">
          <h2 class="kit-h2">{group.title}</h2>
          {isSetup ? (
            <div class="kit-setup-grid">
              {group.sections.map((section) => (
                <KitBlock
                  lang={lang}
                  section={section}
                  groupTitle={group.title}
                  copyStep={section.type === 'copy' ? ++setupCopyStep : undefined}
                />
              ))}
            </div>
          ) : (
            group.sections.map((section) => (
              <KitBlock lang={lang} section={section} groupTitle={group.title} />
            ))
          )}
        </section>
      )
    })}

    <KitChangelog lang={lang} />
  </div>
</div>

<script>
  function initKitToc() {
    const links = document.querySelectorAll<HTMLAnchorElement>('.kit-toc-list a')
    if (!links.length) return

    const sections = [...links]
      .map((a) => {
        const id = a.getAttribute('href')?.slice(1)
        const el = id ? document.getElementById(id) : null
        return el ? { link: a, el } : null
      })
      .filter(Boolean) as Array<{ link: HTMLAnchorElement; el: HTMLElement }>

    if (!sections.length) return

    const setActive = (id: string) => {
      links.forEach((link) => {
        link.classList.toggle('is-active', link.getAttribute('href') === `#${id}`)
      })
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]
        if (visible?.target?.id) setActive(visible.target.id)
      },
      { rootMargin: '-30% 0px -55% 0px', threshold: [0, 0.25, 0.5] },
    )

    sections.forEach(({ el }) => observer.observe(el))

    links.forEach((link) => {
      link.addEventListener('click', () => {
        const id = link.getAttribute('href')?.slice(1)
        if (id) setActive(id)
      })
    })
  }

  initKitToc()
  document.addEventListener('astro:after-swap', initKitToc)
</script>
