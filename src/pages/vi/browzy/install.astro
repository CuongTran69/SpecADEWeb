---
import BaseLayout from '~/layouts/BaseLayout.astro'
import SubpageHeader from '~/components/SubpageHeader.astro'
import BrowzyInstall from '~/components/BrowzyInstall.astro'
import { t } from '~/i18n/strings'
import { pathFor } from '~/i18n/utils'

const lang = 'vi' as const
const strings = t(lang)
---

<BaseLayout lang={lang}>
  <SubpageHeader
    lang={lang}
    title={strings.browzyInstallPage.title}
    subtitle={strings.browzyInstallPage.subtitle}
    homeHref={pathFor(lang, '/')}
    backLabel={strings.browzyInstallPage.backToHome}
  />
  <BrowzyInstall lang={lang} />
</BaseLayout>
